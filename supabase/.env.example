# ---------------------------------------------------------------------------
# Supabase / Edge Functions — Environment Variables (template)
# These are SERVER-SIDE secrets. Copy to .env and fill in real values.
# NEVER commit real secrets. NEVER ship these to the mobile or admin clients.
# ---------------------------------------------------------------------------

# Project connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service-role key — bypasses RLS. Edge Functions / server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (for migrations / admin tooling)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Third-party integration secrets (added as integrations land)
# RESEND_API_KEY=
# EXPO_ACCESS_TOKEN=
