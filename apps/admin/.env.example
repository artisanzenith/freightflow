# ---------------------------------------------------------------------------
# FreightFlow Admin Portal — Environment Variables (template)
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose; RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key (SERVER ONLY — bypasses RLS).
# Use only in server-side code / route handlers. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute site URL used to build auth email redirect links (confirmation,
# password recovery). In production set this to your deployed origin, e.g.
# https://app.freightflow.com. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Sentry (optional, for error monitoring)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (optional, for product analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
