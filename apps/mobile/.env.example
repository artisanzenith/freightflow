# ---------------------------------------------------------------------------
# FreightFlow Mobile App — Environment Variables (template)
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Expo exposes EXPO_PUBLIC_* vars to the app bundle (treat as public).
# ---------------------------------------------------------------------------

# Supabase project URL (safe to expose; RLS enforces access)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose; RLS enforces access)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry (optional, for crash/error monitoring)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (optional, for product analytics)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# NOTE: The Supabase service-role key must NEVER be placed in the mobile app.
# Privileged operations run in Supabase Edge Functions.
