{
  "name": "@freightflow/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "FreightFlow mobile app (React Native + Expo) for drivers and owner-operators.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .expo .turbo"
  },
  "dependencies": {
    "@freightflow/api": "workspace:*",
    "@freightflow/shared": "workspace:*",
    "@freightflow/ui": "workspace:*",
    "@freightflow/validation": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.7",
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0"
  },
  "devDependencies": {
    "@freightflow/config": "workspace:*",
    "@types/react": "~18.3.12",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
