# ---------------------------------------------------------------------------
# FreightFlow — Root Environment Variables (template)
# Copy to .env and fill in real values. NEVER commit .env or .env.local.
#
# App-specific variables live in their own templates:
#   - apps/admin/.env.example   (Next.js admin portal)
#   - apps/mobile/.env.example  (Expo mobile app)
#   - supabase/.env.example     (Supabase / Edge Functions secrets)
# ---------------------------------------------------------------------------

# Shared Supabase project (used by tooling / local scripts)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Turborepo remote cache (optional)
TURBO_TOKEN=
TURBO_TEAM=
